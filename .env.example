# SignalDesk 部署配置。install.sh 首次安装会自动生成 .env 并填好下面三个密码；
# 手动部署时：cp .env.example .env，然后填这三个值。

# 1. 数据库密码（任意强密码）
DB_PASSWORD=

# 2. Redis 密码（任意强密码）
REDIS_PASSWORD=

# 3. JWT 签名密钥 —— 必须 >= 32 字符，且不能是已知的开发默认值，
#    否则进程启动时直接退出。生成：openssl rand -hex 32
JWT_SECRET=

# --- 以下都有默认值，按需改 ---

# 当前运行版本。在线更新由 rst-update.sh 自动改写，不要手动改。
# APP_IMAGE_TAG=

# APP_PORT=3000

# 从浏览器访问的地址。反向代理/换域名时三个都要改。
# API_DOMAIN=http://localhost:3000
# WEBSITE_DOMAIN=http://localhost:3000
# CORS_ORIGIN=http://localhost:3000

# 首次启动创建管理员。账号建好后把这三行删掉。
# SEED_ON_BOOT=1
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=

# 附件存储。多实例部署必须用 s3，否则附件会丢。
# STORAGE_DRIVER=s3
# S3_BUCKET=signaldesk
# S3_ENDPOINT=http://minio:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# 每日数据库备份保留天数（备份在 ./backups）。
# BACKUP_RETENTION_DAYS=30

# 商业版：把许可证 token 填进来即生效，不用换镜像。
# RSTLIC_LICENSE_TOKEN=
