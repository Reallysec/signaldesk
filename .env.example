# SignalDesk 部署配置。install.sh 首次安装会自动生成 .env 并填好下面三个密码；
# 手动部署时：cp .env.example .env，然后填这三个值。

# 1. 数据库密码（任意强密码）
DB_PASSWORD=

# 2. Redis 密码（任意强密码）
REDIS_PASSWORD=

# 3. JWT 签名密钥 —— 必须 >= 32 字符，且不能是已知的开发默认值，
#    否则进程启动时直接退出。生成：openssl rand -hex 32
JWT_SECRET=

# --- 以下都有默认值，按需改 ---

# 当前运行版本。在线更新由 rst-update.sh 自动改写，不要手动改。
# APP_IMAGE_TAG=

# APP_PORT=3000

# 后台一键安装更新（updater 侧车）。install.sh 自动生成/填写；手动部署时：
#   UPDATER_TOKEN 填一个 >= 32 字符的随机串（openssl rand -hex 32），app 与 updater 共用，不要外传；
#   SIGNALDESK_DIR 填本目录的绝对路径（默认 /opt/signaldesk）。不填 UPDATER_TOKEN 则后台只提示手动 rst-update.sh。
#   UPDATER_IMAGE_TAG 是 updater 镜像版本，install.sh 写入，一键安装不改它（不填则用本包版本）。
# UPDATER_TOKEN=
# SIGNALDESK_DIR=/opt/signaldesk
# UPDATER_IMAGE_TAG=

# 从浏览器访问的地址。反向代理/换域名时三个都要改。
# API_DOMAIN=http://localhost:3000
# WEBSITE_DOMAIN=http://localhost:3000
# CORS_ORIGIN=http://localhost:3000

# 首次启动创建管理员。账号建好后把这三行删掉。
# SEED_ON_BOOT=1
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=

# 附件存储。多实例部署必须用 s3，否则附件会丢。
# STORAGE_DRIVER=s3
# S3_BUCKET=signaldesk
# S3_ENDPOINT=http://minio:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Telegram Bot API 地址。直连不了 api.telegram.org（如大陆机房）时改成自建反代。
# Bot Token 会经过这个地址，只能填自己控制的 https 服务。
# TELEGRAM_API_BASE=https://api.telegram.org

# 每日数据库备份保留天数（备份在 ./backups）。
# BACKUP_RETENTION_DAYS=30

# 商业版：把许可证 token 填进来即生效，不用换镜像。
# RSTLIC_LICENSE_TOKEN=
